    "/api/v1/settings/llm": {
      "put": {
        "summary": "Set Llm",
        "description": "Choose Ollama, Gemini, or no LLM. A short test prompt checks the choice first.",
        "operationId": "set_llm_api_v1_settings_llm_put",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LlmUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServerSettings"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
