        ],
        "title": "Body_upload_export_api_v1_imports_post"
      },
      "Candidate": {
        "properties": {
          "tmdb_id": {
            "type": "integer",
            "title": "Tmdb Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "original_title": {
            "type": "string",
            "title": "Original Title"
          },
          "original_language": {
            "type": "string",
            "title": "Original Language"
          },
          "year": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Year"
          },
          "poster_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Poster Path"
          }
        },
        "type": "object",
        "required": [
          "tmdb_id",
          "title",
          "original_title",
          "original_language",
          "year",
          "poster_path"
