        "properties": {
          "pending": {
            "type": "integer",
            "title": "Pending",
            "default": 0
          },
          "matched": {
            "type": "integer",
            "title": "Matched",
            "default": 0
          },
          "review": {
            "type": "integer",
            "title": "Review",
            "default": 0
          },
          "skipped": {
            "type": "integer",
            "title": "Skipped",
            "default": 0
          }
        },
        "type": "object",
        "title": "ImportCounts"
      },
      "ImportJobOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "source": {
            "type": "string",
            "title": "Source"
          },
          "filename": {
            "type": "string",
            "title": "Filename"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          },
          "counts": {
            "$ref": "#/components/schemas/ImportCounts"
          }
        },
        "type": "object",
        "required": [
          "id",
          "source",
          "filename",
          "status",
          "error",
          "created_at",
          "finished_at",
          "counts"
        ],
        "title": "ImportJobOut"
      },
      "ImportRowOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "year": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Year"
          },
          "rating": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rating"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "tmdb_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tmdb Id"
          },
          "candidates": {
            "items": {
              "$ref": "#/components/schemas/Candidate"
            },
            "type": "array",
            "title": "Candidates"
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "year",
          "rating",
          "status",
          "tmdb_id",
          "candidates",
          "message"
        ],
        "title": "ImportRowOut"
      },
      "LanguageCount": {
        "properties": {
          "language": {
            "type": "string",
            "title": "Language"
          },
          "count": {
            "type": "integer",
            "title": "Count"
          }
        },
        "type": "object",
        "required": [
          "language",
          "count"
        ],
        "title": "LanguageCount"
      },
      "LlmSettings": {
        "properties": {
          "provider": {
            "type": "string",
            "enum": [
              "none",
              "ollama",
              "gemini"
            ],
            "title": "Provider"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          },
          "ollama_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ollama Url"
          },
          "gemini_configured": {
            "type": "boolean",
            "title": "Gemini Configured"
          },
          "default_gemini_model": {
            "type": "string",
            "title": "Default Gemini Model",
            "default": "gemini-flash-latest"
          }
        },
        "type": "object",
        "required": [
          "provider",
          "model",
          "ollama_url",
          "gemini_configured"
        ],
        "title": "LlmSettings"
      },
      "LlmUpdate": {
        "properties": {
          "provider": {
            "type": "string",
            "enum": [
              "none",
              "ollama",
              "gemini"
            ],
            "title": "Provider"
          },
          "model": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          },
          "ollama_url": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Ollama Url"
          },
          "gemini_api_key": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 500
              },
              {
                "type": "null"
              }
            ],
            "title": "Gemini Api Key"
          }
        },
        "type": "object",
        "required": [
          "provider"
        ],
        "title": "LlmUpdate"
      },
      "LoginRequest": {
        "properties": {
          "username": {
            "type": "string",
            "title": "Username"
          },
          "password": {
            "type": "string",
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "LoginRequest"
      },
      "Me": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "username": {
            "type": "string",
            "title": "Username"
          },
          "display_name": {
            "type": "string",
            "title": "Display Name"
          },
          "is_admin": {
            "type": "boolean",
            "title": "Is Admin"
          },
          "region": {
            "type": "string",
            "title": "Region"
          },
          "languages": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Languages"
          }
        },
        "type": "object",
        "required": [
          "id",
          "username",
          "display_name",
          "is_admin",
          "region",
          "languages"
        ],
        "title": "Me"
      },
      "PersonaOut": {
